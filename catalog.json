      "dependencies": [
        "tb-db"
      ],
      "components": [
        {
          "name": "Thingsboard-test",
          "description": "ThingsBoard Core Application Server",
          "compose_file": "docker-compose.yml",
          "env_file": ".tb.env.template",
          "default_ports": [
            8080,
            1883,
            7070
          ]
        }
      ]
    },
    {
      "id": "tb-edge",
